{
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/adminPortal",
      "destination": "/adminPortal.html"
    },
    {
      "source": "/adminportal",
      "destination": "/adminPortal.html"
    }
  ]
}
